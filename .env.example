PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/yakstack

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (website, then admin).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

UPLOAD_DIR=uploads

# Public website URL, used to build sitemap.xml and robots.txt.
SITE_URL=http://localhost:5174

# Set to true only when running behind a reverse proxy, so rate limiting sees
# the real client IP rather than the proxy's.
TRUST_PROXY=false

# Optional. Without SMTP credentials, contact-form notifications are logged
# instead of emailed; the lead is always saved either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Fallback notification recipient when Settings has no contact email set.
CONTACT_NOTIFY_EMAIL=

# Required in production. Public marketing media and private applicant files
# must use separate S3-compatible buckets.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=yakstack-public
S3_PRIVATE_BUCKET=yakstack-private
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Generate independently; used only for rotating anonymous analytics hashes.
ANALYTICS_SALT=
PRIVATE_UPLOAD_DIR=private-uploads
